{
  "$schema": "https://app.kilo.ai/config.json",
  "default_agent": "review",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "ai-qa-harness": {
      "type": "local",
      "command": [
        "npx",
        "tsx",
        "src/ai/mcp-server.ts"
      ],
      "enabled": true,
      "timeout": 120000
    }
  },
  "permission": {
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "list": "allow",
    "grep": "allow",
    "bash": "ask",
    "ai-qa-harness_*": "allow",
    "playwright_*": "allow"
  }
}
