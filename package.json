{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript QA automation - a companion framework tested against the Maison Application Under Test (AUT)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npx playwright test",
    "test:api": "npx playwright test --project=api",
    "test:ui": "npx playwright test --project='ui'",
    "test:mobile": "npx playwright test --project='ui mobile-*'",
    "test:ci": "npx playwright test --project='ui chrome' --project='ui firefox' --project='ui webkit' --project='ui mobile-iphone'",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "start": "node maison/server/dist/index.js",
    "start:dev": "cd maison/server && npm start",
    "build:server": "cd maison/server && npm run build",
    "codegen": "npx playwright codegen http://localhost:4000",
    "allure:generate": "cp categories.json allure-results/ && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:clear": "rm -rf allure-results allure-report"
  },
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/runner": "^3.2.7",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.12.1",
    "allure-playwright": "^3.12.0",
    "allure-vitest": "^3.12.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
